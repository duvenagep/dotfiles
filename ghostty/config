#auto-update-channel = tip

# font 
#font-family = Cousine
#font-size = 16
#font-thicken = false

# theme
#theme = dark:Catppuccin Frappe,light:Catppuccin Frappe
fullscreen = true
window-decoration = none
window-padding-x = 10
window-padding-y = 10

# background image
background-image = ~/.config/ghostty/backgrounds/wave.png
background-image-opacity = 0.2
background-image-position = center
background-image-fit = cover

# cursor
cursor-color = #89dceb
custom-shader = shaders/cursor_blaze.glsl
custom-shader-animation = true

# misc
mouse-hide-while-typing = true
macos-icon = xray
